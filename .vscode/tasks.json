{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "just --list",
            "options": {
                "cwd": "${workspaceFolder}/2025/rust"
            },
            "problemMatcher": [],
            "label": "rust: just"
        },
        {
            // exec nix-shell on opening VSCode.
            "label": "my custom shell",
            "command": "nix-shell",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
            },
            "runOptions": {
                "reevaluateOnRerun": false,
                "runOn": "folderOpen"
            }
        },
    ]
}