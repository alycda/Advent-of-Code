    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "just --list",
            "options": {
                "cwd": "${workspaceFolder}/2025/rust"
            },
            "problemMatcher": [],
            "label": "rust: just"
        },
        {
            "label": "My shell",
            "type": "shell",
            "command": "nix-shell",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true,
                "group": "terminals"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "problemMatcher": []
        },
    ]
}